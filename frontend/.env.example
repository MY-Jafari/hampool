# ── HamPool Frontend ─────────────────────────────────────────────
# In development you usually don't need to set anything: Vite proxies
# /api and /ws to the Django backend on localhost:8000.

# Base URL of the REST API (default: '/api/v1/' via the Vite proxy).
VITE_API_BASE_URL=/api/v1/

# WebSocket base URL (default: same origin as the frontend — proxied in dev).
# For a remote backend set e.g. VITE_WS_BASE_URL=ws://localhost:8000
VITE_WS_BASE_URL=

# Where the Vite dev proxy targets (default: http://localhost:8000)
VITE_PROXY_TARGET=http://localhost:8000
