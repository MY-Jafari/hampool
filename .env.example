# ───────────────────────────────────────────────────────────────────
# HamPool – Environment variables template
# ───────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the actual values before running
# the project.  Never commit your real .env file to version control!
#
# The docker-compose stack (db, redis, django, celery, flower, nginx)
# reads these values — the PostgreSQL block below is the default that
# matches the compose `db` service.
# ───────────────────────────────────────────────────────────────────


# ── Django ────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True                     # Set to False in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ── Database (PostgreSQL via docker-compose `db` service) ────────
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=hampool
POSTGRES_DB=hampool
POSTGRES_USER=hampool_user
POSTGRES_PASSWORD=hampool_password    # Change in production!
POSTGRES_HOST=db                      # Docker network hostname
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379


# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ── Flower (Celery monitoring UI – http://localhost:5555) ────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin                 # REQUIRED in production – set a strong one!
FLOWER_PORT=5555                     # Host port (prod compose)


# ── Production tuning (docker-compose.prod.yml) ─────────────────
GUNICORN_WORKERS=4                   # Gunicorn/Uvicorn worker count
GUNICORN_TIMEOUT=120                 # Worker timeout (seconds)
CELERY_CONCURRENCY=4                 # Celery worker concurrency
CELERY_LOG_LEVEL=info                # info | warning | error
NGINX_PORT=80                        # Host port for Nginx


# ── Email (console for dev, SMTP for prod) ───────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password


# ── Gemini AI (Phase 9) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AI_MODEL=gemini-2.5-flash      # Lower rate limits than flash


# ── Sentry (optional) ─────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
