# =============================================================================
# HamPool Project - Complete .gitignore
# =============================================================================

# 1. Django Core & Databases
# -----------------------------------------------------------------------------
*.log
*.pot
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/static/
staticfiles/
*.pyc
# 2. Database Migrations (IMPORTANT: Keep migration files, ignore only caches)
# -----------------------------------------------------------------------------
**/migrations/__pycache__/
**/migrations/*.pyc

# 3. Security & Environment Variables (Never commit secrets)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# 4. Python & Virtual Environments
# -----------------------------------------------------------------------------
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# 5. Build & Distribution
# -----------------------------------------------------------------------------
*.egg-info/
dist/
build/
.eggs/
*.egg

# 6. Celery & Task Queues
# -----------------------------------------------------------------------------
celerybeat-schedule
celerybeat.pid

# 7. Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml
.dockerprod

# 8. IDEs, Editors & OS Specific
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 9. Jupyter Notebook
# -----------------------------------------------------------------------------
.ipynb_checkpoints

# 10. pyenv (Python Version Management)
# -----------------------------------------------------------------------------
.python-version

# 11. Freebuff agent worktrees (never commit these)
# -----------------------------------------------------------------------------
.freebuff/
